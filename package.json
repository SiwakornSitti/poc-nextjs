{
  "name": "my-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && next-export-optimize-images",
    "start": "next start",
    "lint": "next lint",
    "clear-cdn": "gcloud compute url-maps invalidate-cdn-cache poc-nextjs --path '/*' --async",
    "upload": "gsutil -m rm -r gs://poc-nextjs/* && gsutil -m cp -r out/* gs://poc-nextjs",
    "default-cache-header": "gsutil -m setmeta -h 'Cache-Control: public, no-cache' gs://poc-nextjs/**/*",
    "cache-static-header": "gsutil -m setmeta -h 'Cache-Control: public, max-age=31536000, immutable' gs://poc-nextjs/_next/**/*",
    "cache-image-header": "gsutil -m setmeta -h 'Cache-Control: public, max-age=60, must-revalidate' gs://poc-nextjs/_next/static/chunks/images/**/*",
    "cache-headers": "npm run default-cache-header && npm run cache-static-header",
    "deploy": "npm run build && npm run upload && npm run cache-headers && npm run clear-cdn"
  },
  "dependencies": {
    "@faker-js/faker": "^9.0.3",
    "@tanstack/react-query": "^5.54.1",
    "axios": "^1.7.7",
    "eruda": "^3.4.1",
    "framer-motion": "^12.16.0",
    "lodash": "^4.17.21",
    "nanoid": "^5.0.9",
    "next": "^15.3.3",
    "react": "^18",
    "react-dom": "^18",
    "tailwind-merge": "^2.5.2",
    "zustand": "^5.0.0-rc.2"
  },
  "devDependencies": {
    "@designbycode/tailwindcss-text-stroke": "^1.2.1",
    "@tanstack/react-query-devtools": "^5.54.1",
    "@types/lodash": "^4.17.17",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.2.7",
    "next-export-optimize-images": "^4.6.1",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "tailwindcss-text-fill-stroke": "^1.1.0",
    "typescript": "^5"
  },
  "browserlists": [
    "safari >= 14"
  ]
}
